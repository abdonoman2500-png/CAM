# ==============================================================================
# CrossCall Environment Configuration Template
# Keep secrets strictly in Backend Server-Only variables. Never commit .env files.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND PUBLIC VARIABLES (Safe for Vite Browser Build — VITE_* prefix)
# ------------------------------------------------------------------------------
VITE_APP_NAME=CrossCall
VITE_APP_URL=https://your-domain.com

# Optional if using Supabase client SDK directly in browser (NEVER put service role here)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-ONLY VARIABLES (Never exposed to Browser / Flutter)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_NAME=CrossCall
APP_URL=https://your-domain.com
API_URL=https://your-domain.com

# Supabase Auth (Backend verification & PKCE bridge)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 (Direct OIDC + PKCE on Backend)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple (Backend Services ID + ES256 .p8 Assertion)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=
# Or mount a .p8 file path on server instead of inline APPLE_PRIVATE_KEY:
APPLE_PRIVATE_KEY_PATH=

# Security, Redirect Allowlist & Sessions
ALLOWED_REDIRECT_URLS=https://your-domain.com
CORS_ORIGINS=https://your-domain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
AUTH_SESSION_SECRET=
ADMIN_PASSCODE=
