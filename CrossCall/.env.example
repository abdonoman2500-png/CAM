# ==============================================================================
# CrossCall Full Stack Environment Configuration Template
# NEVER commit .env. Keep SUPABASE_SERVICE_ROLE_KEY and OAuth secrets server-only.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. FRONTEND / FLUTTER PUBLIC VARIABLES (Passed via VITE_* or --dart-define)
# ------------------------------------------------------------------------------
VITE_APP_NAME=CrossCall
VITE_APP_URL=https://your-domain.com
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Flutter iOS native SDK only (optional when using Supabase OAuth):
GOOGLE_IOS_CLIENT_ID=

# ------------------------------------------------------------------------------
# 2. BACKEND SERVER-ONLY VARIABLES (Fastify / Express)
# ------------------------------------------------------------------------------
NODE_ENV=production
PORT=4000
APP_NAME=CrossCall
APP_URL=https://your-domain.com
API_URL=https://api.your-domain.com
CROSSCALL_DOMAIN=your-domain.com

# Supabase Auth (Server-only service role key)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google OAuth 2.0 (Web / Server Client ID + Secret)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Sign in with Apple
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY_PATH=./secrets/AuthKey.p8

# Security & Sessions
ALLOWED_REDIRECT_URLS=https://your-domain.com
CORS_ORIGINS=https://your-domain.com
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=30
COOKIE_SECURE=true
COOKIE_SAME_SITE=none
JWT_ACCESS_SECRET=
ADMIN_PASSCODE=

# ------------------------------------------------------------------------------
# 3. SELF-HOSTED VPS INFRASTRUCTURE (Docker / PostgreSQL / Redis / LiveKit / TURN)
# ------------------------------------------------------------------------------
POSTGRES_DB=crosscall
POSTGRES_USER=crosscall_app
POSTGRES_PASSWORD=
DATABASE_URL=postgresql://crosscall_app@postgres:5432/crosscall
REDIS_PASSWORD=
REDIS_URL=redis://redis:6379
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
LIVEKIT_URL=wss://livekit.your-domain.com
TURN_DOMAIN=turn.your-domain.com
TURN_STATIC_SECRET=
EXTERNAL_IP=
